{
  "manifest_version": 3,
  "name": "MyDealz AI Exporter",
  "version": "16.2",
  "description": "Deal-Exporter & KI-Kommentar-Analyse für mydealz.de",
  "permissions": ["storage", "tabs", "clipboardWrite", "downloads"],
  "host_permissions": [
    "https://www.mydealz.de/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.mydealz.de/deals/*", "https://www.mydealz.de/gutscheine/*", "https://www.mydealz.de/diskussion/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.mydealz.de/",
        "https://www.mydealz.de/search*",
        "https://www.mydealz.de/group*",
        "https://www.mydealz.de/gruppe*",
        "https://www.mydealz.de/alle-deals*",
        "https://www.mydealz.de/hei%C3%9F*",
        "https://www.mydealz.de/?*"
      ],
      "js": ["content/listing.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "MyDealz AI Exporter",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [{
    "resources": ["ui/dashboard.html", "ui/dashboard.js"],
    "matches": ["<all_urls>"]
  }]
}
